; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="nCTRL"
config/description="Ioniq 5 N companion with Hyundai USA connectivity and device-secured login."
config/version="0.4"
run/main_scene="res://Main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/N Garage"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]

window/size/viewport_width=460
window/size/viewport_height=920
window/size/window_width_override=460
window/size/window_height_override=920
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[dotnet]

project/assembly_name="IoniqN"

[editor_plugins]

enabled=PackedStringArray("res://addons/ngarage_vault/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.025, 0.043, 0.067, 1)
